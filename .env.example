# Copiez ce fichier en ".env" pour lancer l'agent sur votre PC (inutile sur GitHub Actions).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Sources supplémentaires (facultatives, gratuites) ---
# Sans elles, l'agent n'utilise que LinkedIn, qui bloque de plus en plus souvent.

# Adzuna : une seule paire de clés pour tous les pays (developer.adzuna.com).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble : UNE CLÉ PAR PAYS, à demander sur le domaine du pays concerné.
#   fr.jooble.org/api/about -> JOOBLE_API_KEY_FR
#   uk.jooble.org/api/about -> JOOBLE_API_KEY_UK   (etc.)
# Remplissez seulement les pays qui vous intéressent : les autres restent couverts par LinkedIn.
JOOBLE_API_KEY_FR=
JOOBLE_API_KEY_UK=
JOOBLE_API_KEY_MA=
JOOBLE_API_KEY_NG=
JOOBLE_API_KEY_ZA=

# Pause entre deux requêtes LinkedIn, en secondes. À augmenter si LinkedIn bloque.
# LINKEDIN_PAUSE_SECONDS=6
